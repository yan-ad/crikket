{
  "name": "extension",
  "version": "0.1.1",
  "private": true,
  "description": "manifest.json description",
  "type": "module",
  "scripts": {
    "dev": "wxt --port 5555",
    "dev:firefox": "wxt -b firefox --mv3",
    "dev:safari": "wxt -b safari --mv3",
    "test:firefox": "bun run build:firefox && bunx --bun web-ext run --source-dir .output/firefox-mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:safari": "wxt zip -b safari --mv3",
    "lint:firefox": "bun run build:firefox && bunx --bun web-ext lint --source-dir .output/firefox-mv3",
    "sign:firefox": "bun run build:firefox && bunx --bun web-ext sign --source-dir .output/firefox-mv3 --artifacts-dir .output/firefox-signed --channel unlisted --api-key $WEB_EXT_API_KEY --api-secret $WEB_EXT_API_SECRET",
    "package:safari": "bun run build:safari && sh ./scripts/package-safari.sh",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@crikket/api": "workspace:*",
    "@crikket/capture-core": "workspace:*",
    "@crikket/env": "workspace:*",
    "@crikket/shared": "workspace:*",
    "@crikket/ui": "workspace:*",
    "@orpc/client": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "zod": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/chrome": "^0.1.36",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wxt": "^0.20.6"
  }
}
